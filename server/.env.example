# 复制成 server/.env 后本机启动：npm start
# 这三个密钥只放在服务器上。不要写进 Unity 工程，不要提交。
PORT=8787
HOST=0.0.0.0
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 也接受新版密钥名：SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY

# 1 = 没有登录就不能排队。Render 上保持 1。
REQUIRE_AUTH=0
# 一局多久（毫秒）。正式建议 180000。
MATCH_DURATION_MS=180000
# 人没满时最多等多久再开。搜打撤和首领满 4 人会立刻开。
QUEUE_WAIT_MS=20000
# 浏览器页面的源，多个用逗号。留空则公开接口允许任意源。
WEBGL_ORIGIN=
# 对外的 https 地址。留空则用请求里的 Host。
PUBLIC_URL=
